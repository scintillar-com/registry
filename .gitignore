# Dependencies
node_modules

# Next.js dev cache — the shell's `registry-shell dev/build` writes its
# output to this project's root (via USER_DIST_DIR in the CLI).
.next

# Generator incremental-build manifests — the scripts under scripts/
# (generate:props, generate:a11y, generate:tests) write these to track
# content hashes for skip-on-unchanged. Regenerate from scratch on a
# fresh checkout; keeps git history clean of churn.
public/props/.hashes.json
public/a11y/.hashes.json
public/tests/.hashes.json

# Test output
test-results
playwright-report
coverage
.eslintcache

# TypeScript incremental build cache
*.tsbuildinfo

# npm / pnpm pack output (shouldn't be needed since `private: true`, but
# belt and suspenders)
*.tgz

# Environment secrets
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea
