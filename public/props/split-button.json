        "name": "children",
        "type": "ReactNode",
        "required": true,
        "defaultValue": null,
        "description": "Primary button label."
      },
      {
        "name": "onClick",
        "type": "() => void",
        "required": true,
        "defaultValue": null,
        "description": "Primary button click handler."
      },
      {
        "name": "actions",
        "type": "SplitButtonAction[]",
        "required": true,
        "defaultValue": null,
        "description": "Dropdown actions."
      },
      {
        "name": "variant",
        "type": "enum",
        "required": false,
        "defaultValue": "default",
