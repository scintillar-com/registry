      },
      {
        "name": "size",
        "type": "enum",
        "required": false,
        "defaultValue": "default",
        "description": "Button size."
      },
      {
        "name": "disabled",
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Whether the entire split button is disabled."
