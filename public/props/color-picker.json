[
  {
    "displayName": "ColorPicker",
    "description": "Full-featured color picker with support for solid colors and gradients.\nProvides an HSB saturation/brightness area, hue slider, opacity slider,\nand numeric inputs for multiple color formats (hex, RGB, HSL, CMYK).",
    "props": [
      {
        "name": "value",
        "type": "string",
        "required": true,
        "defaultValue": null,
        "description": "Current hex color value (e.g. \"#6366f1\")."
      },
      {
        "name": "opacity",
        "type": "number",
        "required": false,
        "defaultValue": "100",
        "description": "Current opacity (0–100)."
      },
      {
        "name": "gradient",
        "type": "GradientValue",
        "required": false,
        "defaultValue": null,
        "description": "Initial gradient configuration. Only used when enableGradient is true."
      },
      {
        "name": "onSave",
        "type": "(hex: string, opacity: number, gradient?: GradientValue) => void",
        "required": true,
        "defaultValue": null,
        "description": "Called when the user saves a color selection."
      },
      {
        "name": "onCancel",
        "type": "() => void",
        "required": true,
        "defaultValue": null,
        "description": "Called when the user cancels editing."
      },
      {
        "name": "format",
        "type": "enum",
        "required": false,
        "defaultValue": "hex",
        "description": "Color format for display (hex, rgb, hsl, cmyk)."
      },
      {
        "name": "enableGradient",
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Enable gradient mode tabs (linear, radial, angular)."
      },
      {
        "name": "cancelLabel",
        "type": "string",
        "required": false,
        "defaultValue": "Cancel",
        "description": "Label for the cancel button."
      },
      {
        "name": "saveLabel",
        "type": "string",
        "required": false,
        "defaultValue": "Save",
        "description": "Label for the save button."
      }
    ]
  },
  {
