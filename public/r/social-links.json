9.785 2.627 3.624 3.495 6.275 3.246-4.475.674-8.407 2.523-5.7 7.066 2.757 4.632 5.38.326 6.8-2.482 1.42 2.808 3.243 6.858 6.376 3.127 2.213-2.634 1.863-5.29-2.7-7.711 2.651.249 5.49-.62 6.275-3.246.246-.828.624-5.788.624-6.479 0-.688-.139-1.86-.902-2.203-.66-.299-1.664-.62-4.3 1.24C10.046 4.747 7.087 8.686 6 10.8h6z\" /></svg>,\n  },\n  x: {\n    name: \"X\",\n    icon: <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" className=\"size-4\"><path d=\"M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z\" /></svg>,\n  },\n  linkedin: {\n    name: \"LinkedIn\",\n    icon: <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" className=\"size-4\"><path d=\"M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z\" /></svg>,\n  },\n  reddit: {\n    name: \"Reddit\",\n    icon: <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" className=\"size-4\"><path d=\"M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z\" /></svg>,\n  },\n}\n\nexport interface SocialLinksProps {\n  /** Array of social link entries. */\n  links: SocialLink[]\n  /** Layout direction. */\n  direction?: \"horizontal\" | \"vertical\"\n  /** Show platform name labels. */\n  showLabels?: boolean\n  /** Additional CSS classes. */\n  className?: string\n}\n\n/** Displays a row or column of social media link buttons with platform icons. */\nexport function SocialLinks({\n  links,\n  direction = \"horizontal\",\n  showLabels = false,\n  className,\n}: SocialLinksProps) {\n  if (links.length === 0) return null\n\n  return (\n    <div\n      className={cn(\n        \"flex gap-1.5\",\n        direction === \"vertical\" ? \"flex-col\" : \"flex-row flex-wrap\",\n        className\n      )}\n    >\n      {links.map((link) => {\n        const meta = platformMeta[link.platform]\n        if (!meta) return null\n\n        return showLabels ? (\n          <Button\n            key={link.platform}\n            variant=\"outline\"\n            size=\"sm\"\n            className=\"gap-2 justify-start\"\n            asChild\n          >\n            <a href={link.url} target=\"_blank\" rel=\"noopener noreferrer\">\n              {meta.icon}\n              {link.label ?? meta.name}\n            </a>\n          </Button>\n        ) : (\n          <Button\n            key={link.platform}\n            variant=\"ghost\"\n            size=\"icon-sm\"\n            asChild\n            aria-label={link.label ?? meta.name}\n          >\n            <a href={link.url} target=\"_blank\" rel=\"noopener noreferrer\">\n              {meta.icon}\n            </a>\n          </Button>\n        )\n      })}\n    </div>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
