# Use a flat node_modules layout instead of pnpm's default symlinked
# virtual store. Required for Vercel deployment: Vercel's Next.js
# integration runs its own file-tracing step after our build, and that
# tracer can't correctly resolve pnpm's symlinks (surfaces as ENOENT
# errors referencing paths like `/@swc+helpers@0.5.15/...`). With a
# hoisted layout, every dep lives directly under node_modules/ and the
# tracer has nothing to resolve.
#
# Cost: bigger node_modules on Vercel (~duplicate trees across the
# dep graph). Negligible for a build container.
node-linker=hoisted
